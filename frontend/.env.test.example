# Credentials for a DEDICATED Clerk test account (create one via
# https://dashboard.clerk.com or the Backend API — never reuse a real
# personal account for this). Used by Playwright to sign in through the
# real Clerk widget, never a bypass. CLERK_SECRET_KEY is used only to reset
# this test user's onboarding metadata between runs (never committed for
# real; see RUNBOOK.md).
PLAYWRIGHT_TEST_EMAIL=e2e-test-user@example.com
PLAYWRIGHT_TEST_PASSWORD=change-me
CLERK_SECRET_KEY=sk_test_your_secret_key_here
