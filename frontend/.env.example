# Clerk authentication (community SvelteKit SDK: "svelte-clerk"). Get these
# from https://dashboard.clerk.com — Developers > API Keys. Both are optional:
# if unset, the app runs with authentication disabled (a visible banner
# explains this) so the rest of the product remains inspectable without a
# Clerk account. See RUNBOOK.md for setup.
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: override the default API/TTS proxy targets (see vite.config.ts).
# VITE_API_BASE_URL=/api
# VITE_TTS_BASE_URL=/tts
