GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Clerk publishable key (not secret) -- lets the API verify custom-record
# request tokens via Clerk's public JWKS. Must match frontend/.env.example's
# PUBLIC_CLERK_PUBLISHABLE_KEY. Unset -> local-dev mode (see RUNBOOK.md).
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# MongoDB connection string for persistent longitudinal health-record
# storage (conditions, custom-record encounters, prediction-run history).
# Secret -- never commit a real value. Unset -> persistence is disabled and
# custom records fall back to in-memory-only behavior (see RUNBOOK.md).
MONGODB_URI=mongodb+srv://user:password@your-cluster.mongodb.net/
